{
  "name": "agy-check",
  "version": "0.4.1",
  "description": "Multi-device dashboard, session manager & 1-click multi-account switcher for Antigravity CLI (agy) — persist multiple agy auth profiles in OS keyring, sync Gemini & 3P quota, prompt cache hit rate & cost across desktop, phone PWA, LAN/TUN & remote servers.",
  "main": "runtime/bin/agy-hud.js",
  "files": [
    "runtime",
    "scripts",
    "skills",
    "assets",
    "plugin.json",
    "gemini-extension.json",
    "LICENSE",
    "README.md",
    "README_zh.md",
    "package.json"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kid0114/agy-check.git"
  },
  "homepage": "https://github.com/kid0114/agy-check#readme",
  "bugs": {
    "url": "https://github.com/kid0114/agy-check/issues"
  },
  "scripts": {
    "test": "node --test tests/unit/*.test.mjs",
    "bootstrap": "node scripts/bootstrap.js",
    "verify": "node scripts/verify-display.js",
    "diagnose": "node scripts/diagnose-auth.js",
    "config": "node runtime/bin/agy-hud.js --config",
    "panel": "node runtime/bin/agy-check.js panel",
    "ls": "node runtime/bin/agy-check.js ls"
  },
  "keywords": [
    "antigravity",
    "google-antigravity",
    "antigravity-cli",
    "agy",
    "agy-hud",
    "account-switcher",
    "multi-account",
    "auth-manager",
    "keychain",
    "quota-monitor",
    "statusline",
    "dashboard",
    "session-manager",
    "prompt-cache",
    "ai-coding",
    "pwa",
    "self-hosted",
    "cli"
  ],
  "author": "kid0114 (based on agy-hud by icebear0828)",
  "license": "MIT"
}
